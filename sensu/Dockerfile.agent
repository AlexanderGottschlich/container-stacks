ARG SENSU_VERSION=6.14.2@sha256:b018871078a1525a319d92fa3a9bfbe29a03a0238913249f1f55a10b2c5e4b33
FROM sensu/sensu:${SENSU_VERSION}

USER root
RUN apk add --no-cache \
    bash \
    bind-tools \
    ca-certificates \
    curl \
    netcat-openbsd \
    openssl

COPY checks/ /opt/sensu/checks/
RUN chmod 0755 /opt/sensu/checks/*.sh
