<!doctype html>
<html lang="de">
<head>
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<title>TV Start</title>
<style>
  :root { --bg:#111; --tile:#1b1b1b; --text:#fff; }
  html, body { height: 100%; }
  body { margin:0; background:var(--bg); font-family:Arial,Helvetica,sans-serif; color:var(--text); }
  .wrap { height:100%; display:flex; flex-direction:column; }
  .grid {
    flex:1; display:grid; grid-template-columns:repeat(3,1fr);
    gap:24px; padding:28px; box-sizing:border-box;
  }
  .tile {
    background:var(--tile); border-radius:18px; overflow:hidden;
    outline:none; border:3px solid transparent; cursor:pointer;
    display:flex; align-items:center; justify-content:center;
  }
  .tile:focus { border-color:#fff; box-shadow:0 0 0 3px rgba(255,255,255,.25); }
  .tile img { width:100%; height:100%; object-fit:contain; padding:16px; }
</style>
</head>
<body>
<div class="wrap">
  <div class="grid">
    <div class="tile" tabindex="0" data-url="https://www.youtube.com/tv"><img src="assets/logos/youtube.svg"></div>
    <div class="tile" tabindex="0" data-url="https://www.netflix.com"><img src="assets/logos/netflix.svg"></div>
    <div class="tile" tabindex="0" data-url="https://www.ardmediathek.de"><img src="assets/logos/ard.svg"></div>
    <div class="tile" tabindex="0" data-url="https://www.zdf.de"><img src="assets/logos/zdf.svg"></div>
    <div class="tile" tabindex="0" data-url="https://www.primevideo.com"><img src="assets/logos/primevideo.svg"></div>
    <div class="tile" tabindex="0" data-url="https://www.arte.tv/de/"><img src="assets/logos/arte.svg"></div>
    <div class="tile" tabindex="0" data-url="https://www.rakuten.tv/"><img src="assets/logos/rakuten-tv.svg"></div>
    <div class="tile" tabindex="0" data-url="https://www.disneyplus.com/"><img src="assets/logos/disneyplus.svg"></div>
    <div class="tile" tabindex="0" data-url="https://www.joyn.de/"><img src="assets/logos/joyn.svg"></div>
  </div>
</div>
<script>
(function(){
  const tiles=[...document.querySelectorAll('.tile')];
  if(tiles.length) tiles[0].focus();
  const open=t=>location.href=t.dataset.url;
  tiles.forEach(t=>{
    t.onclick=()=>open(t);
    t.onkeydown=e=>{ if(e.key==='Enter'||e.key===' '){ e.preventDefault(); open(t);} };
  });
})();
</script>
</body>
</html>
